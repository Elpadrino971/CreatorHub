// CreatorHub - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User extended profile (Clerk handles auth)
model User {
  id                 String              @id @default(uuid())
  clerkId            String              @unique
  email              String              @unique
  name               String?
  avatarUrl          String?
  subscriptionTier   SubscriptionTier    @default(FREE)
  subscriptionStatus SubscriptionStatus  @default(TRIALING)
  trialEndsAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  platformConnections PlatformConnection[]
  calendarEvents      CalendarEvent[]
  revenue             Revenue[]
  insights            Insight[]
  subscription        Subscription?
  teamMembers         TeamMember[]
  auditLogs           AuditLog[]

  @@index([clerkId])
  @@index([email])
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

// Platform OAuth connections
model PlatformConnection {
  id                String    @id @default(uuid())
  userId            String
  platform          Platform
  platformUserId    String
  platformUsername  String?
  displayName       String?
  avatarUrl         String?
  accessToken       String // @encrypted in production
  refreshToken      String? // @encrypted in production
  tokenExpiresAt    DateTime?
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics Analytics[]
  content   Content[]
  revenue   Revenue[]

  @@unique([userId, platform])
  @@index([userId, platform])
  @@index([platform, isActive])
}

enum Platform {
  YOUTUBE
  TWITCH
  TIKTOK
  INSTAGRAM
}

// Daily aggregated analytics
model Analytics {
  id           String     @id @default(uuid())
  connectionId String
  date         DateTime   @db.Date
  metricType   MetricType
  metricValue  BigInt
  metricDelta  Int? // change from previous day
  metadata     Json? // platform-specific extra data
  createdAt    DateTime   @default(now())

  // Relations
  connection PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date, metricType])
  @@index([connectionId, date])
  @@index([date, metricType])
}

enum MetricType {
  FOLLOWERS
  VIEWS
  ENGAGEMENT
  WATCH_TIME
  SUBSCRIBERS
  LIVE_VIEWERS
}

// Content (videos, streams, posts)
model Content {
  id                String      @id @default(uuid())
  connectionId      String
  platformContentId String // video ID, stream ID, etc.
  contentType       ContentType
  title             String?
  description       String?     @db.Text
  thumbnailUrl      String?
  url               String?
  publishedAt       DateTime?
  durationSeconds   Int?
  viewsCount        BigInt      @default(0)
  likesCount        Int         @default(0)
  commentsCount     Int         @default(0)
  sharesCount       Int         @default(0)
  engagementRate    Decimal?    @db.Decimal(5, 2)
  isTrending        Boolean     @default(false)
  metadata          Json? // platform-specific data
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  connection PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, platformContentId])
  @@index([connectionId, publishedAt])
  @@index([isTrending, viewsCount])
}

enum ContentType {
  VIDEO
  STREAM
  SHORT
  POST
}

// Content calendar and planning
model CalendarEvent {
  id           String        @id @default(uuid())
  userId       String
  connectionId String?
  title        String
  description  String?       @db.Text
  contentType  ContentType
  status       EventStatus   @default(DRAFT)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  tags         String[]
  notes        String?       @db.Text
  reminderSent Boolean       @default(false)
  metadata     Json? // templates, scripts, etc.
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
}

enum EventStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELED
}

// Revenue tracking
model Revenue {
  id           String      @id @default(uuid())
  userId       String
  connectionId String?
  revenueType  RevenueType
  amount       Decimal     @db.Decimal(10, 2)
  currency     String      @default("USD") @db.VarChar(3)
  periodStart  DateTime    @db.Date
  periodEnd    DateTime    @db.Date
  description  String?
  isEstimated  Boolean     @default(false)
  isPaid       Boolean     @default(false)
  paidAt       DateTime?
  metadata     Json?
  createdAt    DateTime    @default(now())

  // Relations
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, periodStart, periodEnd])
  @@index([connectionId, periodStart])
}

enum RevenueType {
  ADSENSE
  SUBSCRIPTIONS
  DONATIONS
  SPONSORSHIP
  MERCHANDISE
  OTHER
}

// AI-generated insights
model Insight {
  id          String       @id @default(uuid())
  userId      String
  insightType InsightType
  title       String
  description String?      @db.Text
  priority    Priority     @default(MEDIUM)
  isRead      Boolean      @default(false)
  isDismissed Boolean      @default(false)
  actionUrl   String?
  metadata    Json?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, priority])
  @@index([createdAt, expiresAt])
}

enum InsightType {
  PERFORMANCE_ALERT
  BEST_TIME
  TRENDING_TOPIC
  CONTENT_SUGGESTION
  AUDIENCE_GROWTH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Stripe subscriptions
model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([status, tier])
}

// Team collaboration (Phase 2)
model TeamMember {
  id          String           @id @default(uuid())
  userId      String
  memberEmail String
  role        TeamRole
  permissions Json? // granular permissions
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  status      TeamMemberStatus @default(PENDING)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, memberEmail])
  @@index([userId, status])
}

enum TeamRole {
  EDITOR
  COMMUNITY_MANAGER
  VIEWER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

// Audit logs
model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String // 'platform_connected', 'content_published', etc.
  resourceType String? // 'content', 'calendar_event', etc.
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
